{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embers of Aldoria",
  "version": "0.1.0",
  "identifier": "com.aldoria.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Embers of Aldoria", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}

