{
  "name": "embers-of-aldoria",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/client run dev",
    "editor": "npm --prefix apps/client run editor",
    "desktop": "npm --prefix apps/client run desktop",
    "load-test": "node scripts/load-test.mjs",
    "create-load-test-accounts": "node scripts/create-load-test-accounts.mjs",
    "load-test-all": "node scripts/run-load-test.mjs",
    "build": "npm --prefix apps/client run build",
    "test": "npm --prefix apps/client run test",
    "check": "npm --prefix apps/client run check",
    "content:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aldoria-update.ps1",
    "content:update:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aldoria-update.ps1 --dry-run",
    "content:rollback": "node scripts/aldoria-rollback.mjs"
  }
}
