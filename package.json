{
  "name": "embers-of-aldoria",
  "private": true,
  "scripts": {
    "dev": "cargo run -p game-client --bin game-client",
    "editor": "npm --prefix apps/world-editor run dev",
    "desktop": "cargo run -p game-client --bin game-client",
    "load-test": "node scripts/load-test.mjs",
    "create-load-test-accounts": "node scripts/create-load-test-accounts.mjs",
    "load-test-all": "node scripts/run-load-test.mjs",
    "build": "cargo build --release -p game-client --bin game-client",
    "test": "cargo test --workspace",
    "check": "cargo check --workspace",
    "editor:build": "npm --prefix apps/world-editor run build",
    "editor:check": "npm --prefix apps/world-editor run check",
    "editor:test": "npm --prefix apps/world-editor run test",
    "content:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aldoria-update.ps1",
    "content:update:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aldoria-update.ps1 --dry-run",
    "content:rollback": "node scripts/aldoria-rollback.mjs",
    "server": "cargo run -p game-server",
    "server:friends": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-friend-server.ps1",
    "client:build:friends": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-client.ps1",
    "client:updater:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-updater-signing.ps1",
    "client:version": "node scripts/set-client-version.mjs",
    "patch": "node scripts/apply-latest-patch.mjs",
    "patch:check": "node scripts/apply-latest-patch.mjs --check",
    "desktop:release": "cargo run --release -p game-client --bin game-client",
    "native": "cargo run -p game-client --bin game-client",
    "native:release": "cargo run --release -p game-client --bin game-client",
    "native:check": "cargo check -p game-client --bin game-client",
    "native:connect": "cargo run --release -p game-client --bin native-connect"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
